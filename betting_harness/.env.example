# balldontlie.io - https://balldontlie.io/
BALLDONTLIE_API_KEY=

# DeepSeek AI - https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Google Gemini - https://aistudio.google.com/
GEMINI_API_KEY=

# Jev (optional, early access) - https://jev.ai/
JEV_API_KEY=
